<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Helping Hand Backend</display-name>

    <!--
      All servlets in this project are already mapped using the
      @WebServlet("...") annotation in their Java source, so nothing
      else needs to be registered here. This file just needs to exist
      for Tomcat to recognize the app as a valid web application, and
      sets a default welcome behaviour.
    -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
